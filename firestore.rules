rules_version = '2';

// Publish these in Firebase console > Firestore Database > Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMember(businessId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().businessId == businessId;
    }

    function isOwner(businessId) {
      return isMember(businessId) && profile().role == 'owner';
    }

    // A profile can only be created by its own user, and only for a business
    // they own or were invited to. Nobody can edit their own role afterwards.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && (
        (request.resource.data.role == 'owner'
          && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == uid)
        ||
        (request.resource.data.role == 'staff'
          && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.businessId == request.resource.data.businessId)
      );
      allow delete: if signedIn() && isOwner(resource.data.businessId) && resource.data.role != 'owner';
    }

    match /invites/{email} {
      allow read, delete: if signedIn()
        && (request.auth.token.email == email || isOwner(resource.data.businessId));
      allow create: if isOwner(request.resource.data.businessId)
        && request.resource.data.role == 'staff';
    }

    match /businesses/{businessId} {
      allow read: if isMember(businessId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(businessId);

      match /products/{productId} {
        allow read: if isMember(businessId);
        allow create, delete: if isOwner(businessId);
        // Staff may only reduce stock, which is what recording a sale does.
        allow update: if isOwner(businessId) || (
          isMember(businessId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty'])
          && request.resource.data.qty < resource.data.qty
          && request.resource.data.qty >= 0
        );
      }

      // Sales are a permanent record: they can be added but never changed.
      match /sales/{saleId} {
        allow read: if isMember(businessId);
        allow create: if isMember(businessId)
          && request.resource.data.soldById == request.auth.uid
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.total >= 0;
      }

      match /members/{email} {
        allow read: if isMember(businessId);
        allow create, delete: if isOwner(businessId);
        // An invited person may mark only their own entry as active.
        allow update: if isOwner(businessId) || (
          signedIn()
          && request.auth.token.email == email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'uid'])
          && request.resource.data.uid == request.auth.uid
        );
      }
    }
  }
}
